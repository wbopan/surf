{
	"name": "@wenbo/surfclam",
	"version": "0.1.0",
	"description": "surfclam：把 dsh 的 Web UI 装进 macOS 原生壳。伞 bundle——本包不含运行时代码，只有一张编排表（cordis.patch.yml）和一个安装器（bin/surfclam.js）。",
	"type": "module",
	"bin": {
		"surfclam": "./bin/surfclam.js"
	},
	"files": [
		"bin",
		"cordis.patch.yml"
	],
	"exports": {
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@wenbo/clam-app": "^0.1.0",
		"@wenbo/clam-bridge": "^0.1.0",
		"@wenbo/clam-layout": "^0.1.0",
		"@wenbo/clam-sidebar": "^0.1.0",
		"@wenbo/clam-header": "^0.1.0",
		"@wenbo/clam-notify": "^0.1.0",
		"@wenbo/clam-settings": "^0.1.0",
		"@wenbo/clam-nativeify": "^0.1.0",
		"@wenbo/clam-memory": "^0.1.0"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
