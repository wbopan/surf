# Xcode / XcodeGen
*.xcodeproj/
DerivedData/
build/
xcuserdata/
*.xcuserstate

# 构建时间戳（prebuild 脚本每次生成，入库只会让工作区永远脏）
clam-app/host/Sources/Resources/BuildTimestamp.txt

# 共享 module 编译产物（scripts/build-modules.sh 每次构建重生成）
clam-app/host/build-sdk/

# xcodegen 二进制（从 GitHub Releases 下载，或 brew install xcodegen）。
# 挡住它是对的，但**缺了它整个壳就没了**（clam-app 只留一句「优雅缺席」）——
# 所以 `./dev` 的 ensureXcodegen 会从同仓库的其它 worktree 或 PATH 拷一份补上，
# 详见 CLAUDE.md「多 worktree」。
# **必须带路径锚点**：无锚点的 `tools/` 匹配任意层级的同名目录，会把源码工具
# 一起吞掉——clam-nativeify/tools/dump-css.mjs 就这么在库外躺了一阵子。
/clam-app/host/tools/

# 插件依赖解析：指向 harness @deepseek-ai 的本地 symlink（机器相关，勿入库）
# 不带斜杠：`./dev` 在仓库根补的是一条**符号链接**，带斜杠的规则只匹配真目录，会漏。
node_modules

# 邻居插件：纯本地运行时插件，不由本仓库维护（web profile 直接 link 它）
/dsh-web-search-firecrawl/

# firecrawl 抓取的本地调研残留
.firecrawl/

# macOS
.DS_Store

# Swift Package Manager (unused so far)
.build/
.swiftpm/

# 外来工具在本目录里生成的东西（gws generate-skills 会往 skills/ 里灌一堆
# SKILL.md）。跟本仓库无关，别让它随手漏进来。
skills/

# spike 产物（dylib/截图，可由 build.sh 重生成）
docs/spikes/*/out/

# hover spike 的可执行产物（每个都有同名 .swift，run.sh 可重编）
# hover spike 改成白名单：只收源码、脚本与说明。逐个列可执行文件的写法
# 每加一个探针就漏一个（meanabs 就这么漏进来过）。
docs/spikes/hover/*
!docs/spikes/hover/*.swift
!docs/spikes/hover/*.sh
!docs/spikes/hover/*.md

# Claude Code 的工作区：settings.json 是项目配置、该入库，worktrees/ 底下却是
# 一个个真正的 git worktree（每个都有自己的 .git）——把它们提交进来等于把仓库
# 套进自己。只挡 worktrees/，别挡整个 .claude/。
/.claude/worktrees/

# 截图等临时输出的统一落点（tools/shot.sh 不给 out 参数时就落这儿）
/.scratch/

# shot.sh 自己的二进制缓存（源码没变就复用，改了自动重编）
/tools/.cache/

# 兜底：给 shot.sh 传了相对路径、又恰好 cd 在壳工程根时的残留
/clam-app/host/*.png

# 预编译工具的产物（scripts/prebuild-plugins.sh 按源码 hash 重编）
/clam-app/host/build-prebuild/
