{
  "name": "@wenbo/dash-nativeify",
  "version": "0.1.0",
  "description": "让 dsh Web UI 摸起来像原生 macOS App：禁 document 橡皮筋、UI 文本不可选中（纯 CSS，零服务依赖）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
