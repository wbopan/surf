{
  "name": "@wenbo/clam-app",
  "version": "0.1.0",
  "description": "Surfclam macOS 壳的宿主插件：以 host/ 的 Xcode 工程为载荷，按需构建、写 endpoint 发现文件、拉起 Surfclam.app，并 provide 'clamApp'。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "host/project.yml",
    "host/Sources",
    "host/scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
